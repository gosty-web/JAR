# JAR Core Configuration

# LLM Configuration
# By default, JAR uses `litellm` which supports OpenAI, Anthropic, Groq, OpenRouter, etc.
JAR_LLM_MODEL="opencode/deepseek-v4-flash-free"

# If you are using OpenCode Zen or a custom OpenAI-compatible endpoint, set the Base URL here:
# Example for OpenCode Zen: "https://opencode.ai/zen/v1"
JAR_LLM_BASE_URL="https://opencode.ai/zen/v1"

# Your API Key for the chosen provider
JAR_LLM_API_KEY="sk-Aco3byX0TVBXEbNzaVmDBxonTpOrY3dSbYkPlWNjpMAWc2gfGnTqWP2sFzaA1J6m"

# WebSockets
JAR_WS_PORT=8000
